# Copy this file to .env and fill in your own values. Never commit .env.

# Required for answer generation (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides (defaults shown)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=4
# MIN_SIMILARITY=0.25
# CHROMA_DIR=.chroma
# CHROMA_COLLECTION=policy_chunks
